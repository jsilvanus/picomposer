{
  "name": "picomposer",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Agentic Generative UI & Multi-Screen Workspace Composer for the Pi Broadcast Ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "picomposer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@piecosystem/piui": "file:../piui",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pi": {
    "service": "picomposer",
    "displayName": "PiComposer",
    "layer": "+1 Presentation Plane",
    "port": 3460,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PICOMPOSER_PORT"
  }
}
